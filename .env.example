# AWS Region Configuration
AWS_REGION=us-east-1

# Amazon Bedrock Model ID (e.g., anthropic.claude-3-haiku-20240307-v1:0 or amazon.titan-text-express-v1)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# S3 & DynamoDB Configuration
S3_BUCKET_NAME=lifeos-documents-bucket
DYNAMODB_TABLE_PREFIX=LifeOS

# Amazon Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=exampleclientid123456

# Frontend API Gateway Endpoint URL (Set when connecting to live AWS deployment)
VITE_API_BASE_URL=https://xyz.execute-api.us-east-1.amazonaws.com/Prod
